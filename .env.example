# See README.md "Local setup" for what each of these is for.

# AI gatekeeper — required
OPENAI_API_KEY=

# On-chain reads/writes — required
SOLANA_RPC_URL=https://api.devnet.solana.com

# Headless agent API auth (/api/agent-action) — any string you choose
AGENT_API_KEY=

# Persistence — omit both to fall back to local JSON files under .wallets/
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Verifier photo proof storage
BLOB_READ_WRITE_TOKEN=

# New-round notification emails — omit to skip sending
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Google sign-in (Privy) for people without a Solana wallet — creates a real
# embedded wallet on first login. Public identifier, safe to expose
# client-side. Omit to skip: everything else still works, just without the
# "Continue with Google" option on /verify.
NEXT_PUBLIC_PRIVY_APP_ID=
